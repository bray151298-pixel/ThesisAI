# ==========================================================
#  ThesisAI - PLANTILLA de configuracion (SIN claves reales)
#  Copia este archivo como  .env  y rellena tus claves.
#  El archivo .env NUNCA se sube a internet (esta en .gitignore).
#  La IA usa la primera disponible:  Gemini -> Groq -> Ollama
# ==========================================================

# 1) Google Gemini  (RECOMENDADO, gratis, sin tarjeta)
#    Consigue tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# 2) Groq  (opcional, gratis, respaldo si Gemini se queda sin cupo)
#    Consigue tu clave en: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3) Ollama  (opcional, 100% offline en tu PC)
#    Instala Ollama (https://ollama.com) y ejecuta:  ollama pull llama3.1
OLLAMA_MODEL=llama3.1
OLLAMA_HOST=http://localhost:11434

# 4) CORE  (busca TESIS en repositorios universitarios)
#    Clave GRATIS en: https://core.ac.uk/services/api
CORE_API_KEY=

# 5) Contrasena de acceso (para cuando la publiques en internet).
#    Vacia = sin login (uso local). Pon una contrasena para protegerla.
APP_PASSWORD=

# Email para el "pool cortes" de OpenAlex/Crossref (opcional)
CONTACT_EMAIL=
